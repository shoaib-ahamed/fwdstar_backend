# Database Configuration
# Choose ONE of the following options:

# 1. Supabase (Cloud PostgreSQL - Recommended)
# Get these values from your Supabase project dashboard > Settings > Database
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_SUPABASE_PASSWORD]@[YOUR_SUPABASE_HOST]:5432/postgres

# 2. Local PostgreSQL (development only)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fwdstar_dev

# 3. SQLite (development only, not for production)
# DATABASE_URL=sqlite+aiosqlite:///./fwdstar.db

# Supabase-specific configuration
SUPABASE_URL=https://[YOUR_SUPABASE_PROJECT_ID].supabase.co
SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]

# JWT Security Configuration
# Generate a secure SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_32_CHARACTER_STRING

# JWT Algorithm (HS256 is recommended)
ALGORITHM=HS256

# Token Expiration Times
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Application Environment
# Set to "development" for local development
# Set to "production" for production deployment
ENVIRONMENT=development

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# For development: http://localhost:3000,http://localhost:5173
# For production: https://yourdomain.com
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Password Hashing
# bcrypt cost factor (default: 12, min recommended: 12)
BCRYPT_COST=12
